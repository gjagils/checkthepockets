# ============================================================
# Check The Pockets - omgevingsvariabelen
# ============================================================
# Voorbeeld voor lokaal gebruik (kopieer naar .env) en referentie voor de Portainer-stack.
# Productiewaarden horen in Portainer (Stack > Environment), nooit in Git.
# De bron van waarheid is app/config.py; hier staan dezelfde sleutels.
#
# [verplicht in productie] = de app weigert te starten zonder een geldige waarde
# (zie validate_production_config in app/config.py).
# ============================================================

# --- Database --------------------------------------------------
# [verplicht] PostgreSQL-verbinding, bijv. een Neon-connectionstring.
DATABASE_URL=postgresql://gebruiker:wachtwoord@host:5432/checkthepockets

# --- App en sessies ----------------------------------------------
# [verplicht in productie] Uniek, minimaal 32 tekens. Genereer: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# [verplicht in productie] Openbare URL, https://
APP_URL=https://jouw-domein.example
# development | production (production eist https, veilige cookies en versleuteling)
ENVIRONMENT=development
# Wordt vanzelf true bij een https APP_URL; zet true in productie.
COOKIE_SECURE=
# Levensduur van de sessiecookie in seconden (standaard 86400)
SESSION_MAX_AGE=86400
# CSRF-controle op Origin; in productie altijd aan
CSRF_ENFORCE=false
REGISTRATION_OPEN=true
REQUIRE_EMAIL_VERIFICATION=false
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Gebruikersnaam die nooit gedeactiveerd of verwijderd kan worden; ook de enige met bankkoppelingen
SUPER_ADMIN_USERNAME=

# --- Versleuteling ----------------------------------------------
# [verplicht in productie] Fernet-sleutel voor veldversleuteling van transacties en bunq-sleutels.
# Genereer: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- E-mail (Resend) ---------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@check-your-pockets.com

# --- Google-login ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI-suggesties (Anthropic) ------------------------------------
ANTHROPIC_API_KEY=
# Leeg = standaardmodel uit app/config.py; zet hier een ander model als het standaardmodel wordt uitgefaseerd
ANTHROPIC_MODEL=

# --- Enable Banking (PSD2-bankkoppeling) ---------------------------
# Maak een app aan op https://enablebanking.com/cp/applications en download de private key (.pem).
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=/app/keys/enable-banking.pem

# --- bunq (eigen API-sleutel) --------------------------------------
# Standaard productie; sandbox: https://public-api.sandbox.bunq.com/v1
BUNQ_API_BASE=https://api.bunq.com/v1
