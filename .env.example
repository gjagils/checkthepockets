# ============================================================
# Check The Pockets - Environment Variables
# ============================================================
# Kopieer dit bestand naar .env en pas de waarden aan,
# of stel deze variabelen in via Portainer > Stack > Environment.
#
# Alle variabelen hebben standaardwaarden en zijn optioneel.
# Alleen SECRET_KEY moet je aanpassen voor productie.
# ============================================================

# App
SECRET_KEY=verander-dit-in-een-lang-willekeurig-wachtwoord
APP_PORT=8100

# Database
POSTGRES_USER=checkthepockets
POSTGRES_PASSWORD=checkthepockets
POSTGRES_DB=checkthepockets
